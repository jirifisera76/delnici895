# =========================================================
# .htaccess pro studiodilna.cz (Zoner shared hosting / Apache)
# =========================================================
# Po nahrání na FTP umístit do kořenového adresáře webu (vedle index.html).
# Tento soubor řeší: HTTPS redirect, kanonická doména, bezpečnostní hlavičky,
# kompresi a cache. Funguje na typickém Zoner Apache hostingu (mod_rewrite,
# mod_headers, mod_deflate, mod_expires).

# ---------------------------------------------------------
# 1) HTTPS + kanonická doména (force HTTPS, force non-www)
# ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Vynutí HTTPS — http:// na https://
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Sjednotí na non-www variantu (www.studiodilna.cz → studiodilna.cz).
  # Dvě verze rozdělují link juice, bezpečnější mít jednu.
  # Pokud byste chtěla naopak www jako kanonickou, prohoďte podmínky.
  RewriteCond %{HTTP_HOST} ^www\.studiodilna\.cz$ [NC]
  RewriteRule ^ https://studiodilna.cz%{REQUEST_URI} [L,R=301]

  # Hezká URL — odstraní .html z URL ve Search (volitelné, nezávazné)
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteCond %{REQUEST_FILENAME}\.html -f
  # RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------------------------------------------------------
# 2) BEZPEČNOSTNÍ HLAVIČKY
# ---------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS — prohlížeč donutí používat HTTPS po dobu 1 roku.
  # `preload` umožňuje zápis do Chrome HSTS preload listu (po žádosti na hstspreload.org).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Zabrání MIME-sniffingu — prohlížeč vždy věří Content-Type hlavičce.
  Header always set X-Content-Type-Options "nosniff"

  # Zakáže vkládání webu do <iframe> (clickjacking ochrana).
  Header always set X-Frame-Options "DENY"

  # Referrer-Policy — neposílá full URL při přechodu mimo doménu (privacy).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy — vypne unused browser features (geo, mic, kamera atd.).
  # Geolocation povoleno pro Google Maps Embed (jen self).
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), fullscreen=(self)"

  # Content-Security-Policy — striktní whitelist domén, ze kterých se mohou
  # načítat scripty, styly, fonty, obrázky a do kterých může směřovat formulář.
  # Pokud něco rozbije, zkontrolujte Console v DevTools (CSP violation messages)
  # a doplňte odpovídající doménu sem.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://maps.googleapis.com https://places.googleapis.com https://www.google-analytics.com https://*.google.com https://docs.google.com https://script.google.com https://script.googleusercontent.com https://formspree.io https://images.unsplash.com; form-action 'self' https://formspree.io; frame-src 'self' https://www.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # X-XSS-Protection — legacy header (moderní browsery to ignorují,
  # ale starší IE/Safari na něj reagují). Bez negativních důsledků.
  Header always set X-XSS-Protection "1; mode=block"

  # Cross-Origin-Opener-Policy — izoluje window referenci (proti Spectre).
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# ---------------------------------------------------------
# 3) GZIP / BROTLI KOMPRESE
# ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml image/svg+xml font/ttf font/otf application/x-font-ttf application/x-font-otf application/font-woff application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>

# ---------------------------------------------------------
# 4) CACHE — statické soubory cachovat dlouho, HTML krátce
# ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — krátká cache, ať se nové verze rychle propíší
  ExpiresByType text/html "access plus 1 hour"

  # CSS, JS, fonty — dlouhá cache, mají ?v=NNN cache busting v URL
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Obrázky a SVG — dlouhá cache
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Manifest, sitemap, robots — středně dlouhá cache
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"

  # Default — krátká
  ExpiresDefault "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------
# 5) DROBNÉ ÚPRAVY
# ---------------------------------------------------------

# Vypnout výpis adresářů (kdyby uživatel přišel na cestu bez index.html)
Options -Indexes

# Skrýt Apache verzi v hlavičkách
ServerSignature Off

# Charset default UTF-8
AddDefaultCharset UTF-8

# 404 stránka (později můžete vytvořit /404.html, do té doby vypnuto)
# ErrorDocument 404 /404.html
